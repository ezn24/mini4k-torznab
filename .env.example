# Required. Generate a new long random value; do not reuse the example.
API_KEY=replace-with-a-long-random-value

# Use the published image, or change this to mini4k-torznab:local for a local build.
MINI4K_IMAGE=ghcr.io/ezn24/mini4k-torznab:latest

# Existing Docker network shared by Prowlarr and FlareSolverr.
MEDIA_NETWORK=jellyfin_default
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Used only when compose.flaresolverr.yml creates FlareSolverr for you.
FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:latest
FLARESOLVERR_LOG_LEVEL=info
TZ=Australia/Sydney

# Host path or a path relative to compose.yml.
DATA_PATH=./data
PUBLISHED_PORT=8787

# Generated by credential_tool.py. Leave blank until configured.
MINI4K_CREDENTIALS_KEY=
MINI4K_CREDENTIALS_TOKEN=

# Optional tuning.
MAX_WORKS=1
MAX_RESULTS=100
FLARESOLVERR_MAX_TIMEOUT=180000
FLARESOLVERR_HTTP_TIMEOUT=210
BROWSER_LOCK_TIMEOUT=30
TRACKER_SCRAPE_ENABLED=true
TRACKER_SCRAPE_TIMEOUT=3
TRACKER_SCRAPE_CACHE_MINUTES=30
TRACKER_SCRAPE_MAX_RESULTS=50
TRACKER_SCRAPE_WORKERS=12

